# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
BASE_URL=http://localhost:8000

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./carecloud_patients.db

# Vapi Voice AI Platform Configuration
# Get your API key from https://dashboard.vapi.ai/api-keys
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=

# Webhook Security (Optional shared secret)
VAPI_WEBHOOK_SECRET=

# Telephony / Live Demo
PHONE_NUMBER=+1-xxx-xxx-xxxx
